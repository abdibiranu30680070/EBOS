# ─────────────────────────────────────────────
# EBOS Backend — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Database Configuration
# For local development: DATABASE_URL=postgresql://localhost:5432/postgres
# For Render deployment: DATABASE_URL should be set in Render dashboard
DATABASE_URL=postgresql://localhost:5432/postgres
JWT_SECRET="change-me-to-a-very-long-random-secret-key"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development
